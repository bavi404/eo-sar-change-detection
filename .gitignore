models/checkpoints/**
!models/checkpoints/.gitkeep
*.pt
*.pth
*.ckpt

# Local run artifacts
models/checkpoints/visualizations/
data/*.png
*.tmp

# OS / packaging
Thumbs.db
*.zip
*.log
