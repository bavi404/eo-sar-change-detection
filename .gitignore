# Python bytecode / cache
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/

# Virtual environments
.venv/
venv/
env/
galaxeye/

# IDE
.idea/
.vscode/
*.swp
.DS_Store

